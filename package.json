{
  "name": "syncbay",
  "private": true,
  "scripts": {
    "prebuild": "prisma generate",
    "build": "react-router build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "node scripts/start-react-router.mjs",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "quality:react-doctor": "react-doctor --scope full --blocking error .",
    "perf:loaders": "node scripts/measure-loader-performance.mjs",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "ui:render": "node scripts/syncbay-ui-render.mjs",
    "ui:preview": "npm run ui:preview:panoramica && npm run ui:preview:catalogo && npm run ui:preview:conflitti && npm run ui:preview:importazione && npm run ui:preview:attivita && npm run ui:preview:impostazioni",
    "ui:preview:attivita": "node scripts/syncbay-ui-render.mjs attivita --fixture",
    "ui:preview:catalogo": "node scripts/syncbay-ui-render.mjs catalogo --fixture",
    "ui:preview:conflitti": "node scripts/syncbay-ui-render.mjs conflitti --fixture",
    "ui:preview:impostazioni": "node scripts/syncbay-ui-render.mjs impostazioni --fixture",
    "ui:preview:importazione": "node scripts/syncbay-ui-render.mjs importazione --fixture",
    "ui:preview:panoramica": "node scripts/syncbay-ui-render.mjs panoramica --fixture",
    "ui:shot-live": "node scripts/syncbay-ui-shot-live.mjs",
    "ui:seed-local": "PGPASSWORD=postgres psql -h 127.0.0.1 -p 54322 -U postgres -d postgres -f scripts/syncbay-seed-local-preview.sql",
    "test:lib": "node --test --experimental-strip-types app/lib/*.test.ts",
    "coverage:lib": "node --test --experimental-strip-types --experimental-test-coverage --test-coverage-include='app/lib/*.ts' --test-coverage-exclude='app/lib/*.test.ts' --test-coverage-lines=75 --test-coverage-branches=65 app/lib/*.test.ts",
    "test:stock-guard": "node --test --experimental-strip-types app/lib/syncbay-stock-guard.test.ts",
    "shopify": "shopify",
    "prisma": "prisma",
    "vite": "vite",
    "pretypecheck": "prisma generate",
    "typecheck": "react-router typegen && tsc --noEmit",
    "db:advisors:security": "npx supabase db advisors --linked --type security",
    "db:advisors:performance": "npx supabase db advisors --linked --type performance",
    "db:push:dry-run": "npx supabase db push --linked --dry-run",
    "db:verify": "npm run db:advisors:security && npm run db:advisors:performance",
    "doctor:local": "node scripts/syncbay-local-doctor.mjs",
    "publish:preflight": "node scripts/syncbay-publish-preflight.mjs",
    "ebay:rate-limits": "node scripts/syncbay-ebay-rate-limits.mjs",
    "import:repair-commercial-fields": "node scripts/syncbay-import-repair-commercial-fields.mjs",
    "import:verify": "node scripts/syncbay-import-verify.mjs",
    "products:publish-channel": "node scripts/syncbay-publish-products-to-publication.mjs",
    "jobs:status": "node scripts/syncbay-job-status.mjs",
    "jobs:archive-stale-failures": "node scripts/syncbay-archive-stale-sync-failures.mjs",
    "jobs:coalesce-shopify-changes": "node scripts/syncbay-coalesce-shopify-change-jobs.mjs",
    "orders:paid-readiness": "node scripts/syncbay-orders-paid-readiness.mjs",
    "conflicts:doctor": "node scripts/syncbay-conflicts-doctor.mjs",
    "conflicts:repair-description": "node scripts/syncbay-repair-description-conflicts.mjs",
    "descriptions:cleanup-report": "node --experimental-strip-types scripts/syncbay-description-cleanup-report.mjs",
    "descriptions:backfill-cleanup": "node --experimental-strip-types scripts/syncbay-description-backfill.mjs",
    "stock:restore-ebay": "node scripts/syncbay-restore-ebay-stock.mjs",
    "ebay:store-category-orphans": "node scripts/syncbay-store-category-orphans.mjs",
    "categories:backfill": "node --experimental-strip-types scripts/syncbay-category-backfill.mjs",
    "facets:backfill": "node --experimental-strip-types scripts/syncbay-product-facets-backfill.mjs",
    "catalog:images:doctor": "node scripts/syncbay-catalog-images-doctor.mjs",
    "catalog:backfill-archived-soldout": "node scripts/syncbay-backfill-archived-to-soldout.mjs",
    "prisma:validate": "DATABASE_URL=${DATABASE_URL:-postgresql://user:pass@localhost:5432/syncbay} DATABASE_DIRECT_URL=${DATABASE_DIRECT_URL:-postgresql://user:pass@localhost:5432/syncbay} prisma validate",
    "release": "node scripts/release.mjs",
    "release:dry-run": "node scripts/release.mjs --dry-run",
    "doctor": "react-doctor"
  },
  "type": "module",
  "engines": {
    "node": ">=24.15 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-router/dev": "^7.18.0",
    "@react-router/fs-routes": "^7.18.0",
    "@react-router/node": "^7.18.0",
    "@react-router/serve": "^8.0.1",
    "@shopify/app-bridge-react": "^4.2.11",
    "@shopify/cli": "4.2.0",
    "@shopify/shopify-app-react-router": "^1.2.0",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "fast-xml-parser": "^5.9.3",
    "isbot": "^5.1.44",
    "prisma": "^6.19.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.18.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.9.2",
    "@eslint/js": "^10.0.1",
    "@shopify/polaris-types": "^1.0.7",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vercel/react-router": "^1.3.1",
    "eslint": "^10.5.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "playwright": "^1.61.0",
    "prettier": "^3.8.4",
    "react-doctor": "^0.5.8",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "ajv@8.6.3": "8.20.0",
    "esbuild": "0.28.1",
    "p-map": "^4.0.0",
    "global-agent": "4.1.3"
  },
  "author": "Matteo",
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  }
}
